# ==============================================================================
# SOUT Server - Environment Variables Template
# Copy this file to `.env` and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MOBILE_URL=http://localhost

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL >= 15 with Prisma 8)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/heed_database"

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Session, OTP verification, Rate limiting)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing Access and Refresh JWT tokens
JWT_SECRET="your_jwt_super_secret_key_change_in_production"

# ------------------------------------------------------------------------------
# 5. Email / Mailer Configuration (Nodemailer with Gmail)
# ------------------------------------------------------------------------------
# For Gmail: Use your full email address and a 16-character App Password
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_USER="your_email@gmail.com"
MAIL_PASSWORD="your_gmail_app_password"

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Configuration (Native Cloudflare API)
# ------------------------------------------------------------------------------
# Obtain from your Cloudinary Dashboard: https://console.cloudinary.com
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="sout-media"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"